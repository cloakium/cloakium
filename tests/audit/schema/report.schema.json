{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cloakium.audit.report/1",
  "title": "Cloakium audit report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "planId",
    "planHash",
    "suite",
    "environment",
    "targets",
    "runs",
    "errors",
    "started",
    "finished",
    "complete",
    "completeness",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "cloakium.audit.report/1"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "planId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "planHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "suite": {
      "$ref": "#/$defs/suite"
    },
    "environment": {
      "$ref": "#/$defs/resolvedEnvironment"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/inventoryRecord"
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/auditError"
      }
    },
    "started": {
      "type": "string",
      "minLength": 1
    },
    "finished": {
      "type": "string",
      "minLength": 1
    },
    "complete": {
      "type": "boolean"
    },
    "completeness": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "processCleanup": {
      "$ref": "#/$defs/processCleanup"
    },
    "postprocessingRecovery": {
      "$ref": "#/$defs/postprocessingRecovery"
    }
  },
  "$defs": {
    "displayKind": {
      "enum": [
        "external-owned",
        "managed"
      ]
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "width",
        "height",
        "depth",
        "dpi",
        "windowManager"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/displayKind"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "depth": {
          "type": "integer",
          "minimum": 1
        },
        "dpi": {
          "type": "integer",
          "minimum": 1
        },
        "windowManager": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "xauthorityPath": {
          "type": "string",
          "pattern": "^/"
        },
        "ownershipManifestPath": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "osFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "versionId",
        "prettyName",
        "buildId",
        "kernel",
        "arch"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "versionId": {
          "type": "string"
        },
        "prettyName": {
          "type": "string"
        },
        "buildId": {
          "type": "string"
        },
        "kernel": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "timezoneFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "zoneinfoPath",
        "exists"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "zoneinfoPath": {
          "type": "string",
          "pattern": "^/"
        },
        "exists": {
          "type": "boolean"
        }
      }
    },
    "fontconfigFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaredFile",
        "realPath",
        "exists",
        "sha256"
      ],
      "properties": {
        "declaredFile": {
          "type": "string",
          "pattern": "^/"
        },
        "realPath": {
          "type": "string",
          "pattern": "^/"
        },
        "exists": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "declaredPath": {
          "type": "string",
          "pattern": "^/"
        },
        "pathRealPath": {
          "type": "string",
          "pattern": "^/"
        },
        "pathExists": {
          "type": "boolean"
        }
      }
    },
    "displayFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "socketPath": {
          "type": "string",
          "pattern": "^/"
        },
        "socketExists": {
          "type": "boolean"
        },
        "xauthorityPath": {
          "type": "string",
          "pattern": "^/"
        },
        "xauthorityRealPath": {
          "type": "string",
          "pattern": "^/"
        },
        "xauthorityExists": {
          "type": "boolean"
        },
        "xauthorityMode": {
          "type": "string"
        },
        "ownershipManifestPath": {
          "type": "string",
          "pattern": "^/"
        },
        "ownershipManifestRealPath": {
          "type": "string",
          "pattern": "^/"
        },
        "ownershipManifestExists": {
          "type": "boolean"
        },
        "ownershipManifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "localeFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared",
        "source",
        "processLang",
        "processLcAll"
      ],
      "properties": {
        "declared": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "processLang": {
          "type": "string",
          "minLength": 1
        },
        "processLcAll": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environmentPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "inherited",
        "appliedKeys",
        "displayKeys",
        "headlessDisplay"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "inherited": {
          "const": false
        },
        "appliedKeys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "displayKeys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "headlessDisplay": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resolvedFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "timezone",
        "display",
        "locale",
        "environment"
      ],
      "properties": {
        "os": {
          "$ref": "#/$defs/osFacts"
        },
        "timezone": {
          "$ref": "#/$defs/timezoneFacts"
        },
        "fontconfig": {
          "$ref": "#/$defs/fontconfigFacts"
        },
        "display": {
          "$ref": "#/$defs/displayFacts"
        },
        "locale": {
          "$ref": "#/$defs/localeFacts"
        },
        "environment": {
          "$ref": "#/$defs/environmentPolicy"
        }
      }
    },
    "resolvedEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "locale",
        "timezoneId",
        "display",
        "resolved"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "timezoneId": {
          "type": "string",
          "minLength": 1
        },
        "fontconfigFile": {
          "type": "string",
          "pattern": "^/"
        },
        "fontconfigPath": {
          "type": "string",
          "pattern": "^/"
        },
        "fontManifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "display": {
          "$ref": "#/$defs/display"
        },
        "notes": {
          "type": "string"
        },
        "resolved": {
          "$ref": "#/$defs/resolvedFacts"
        },
        "diagnostics": {
          "type": "object",
          "additionalProperties": true
        },
        "environmentReceipt": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "sandboxFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystemOnly",
        "setuid",
        "setgid",
        "worldWritable",
        "runtimeExercised"
      ],
      "properties": {
        "filesystemOnly": {
          "const": true
        },
        "setuid": {
          "type": "boolean"
        },
        "setgid": {
          "type": "boolean"
        },
        "worldWritable": {
          "type": "boolean"
        },
        "runtimeExercised": {
          "const": false
        }
      }
    },
    "elfMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "endianness",
        "osAbi",
        "abiVersion",
        "elfType",
        "machine",
        "machineCode",
        "entry",
        "programHeaders",
        "sectionHeaders"
      ],
      "properties": {
        "class": {
          "enum": [
            "ELF32",
            "ELF64"
          ]
        },
        "endianness": {
          "enum": [
            "little",
            "big"
          ]
        },
        "osAbi": {
          "type": "string",
          "minLength": 1
        },
        "abiVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "elfType": {
          "type": "string",
          "minLength": 1
        },
        "machine": {
          "type": "string",
          "minLength": 1
        },
        "machineCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "entry": {
          "type": "integer",
          "minimum": 0
        },
        "programHeaders": {
          "type": "integer",
          "minimum": 0
        },
        "sectionHeaders": {
          "type": "integer",
          "minimum": 0
        },
        "interpreter": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originalPath",
        "realPath",
        "symlink",
        "sha256Before",
        "sha256After",
        "unchanged",
        "size",
        "mode",
        "modeBits",
        "uid",
        "gid",
        "executable",
        "permissions"
      ],
      "properties": {
        "originalPath": {
          "type": "string",
          "pattern": "^/"
        },
        "realPath": {
          "type": "string",
          "pattern": "^/"
        },
        "symlink": {
          "type": "boolean"
        },
        "sha256Before": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sha256After": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "unchanged": {
          "const": true
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "type": "string",
          "pattern": "^[0-7]{4}$"
        },
        "modeBits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "uid": {
          "type": "integer",
          "minimum": 0
        },
        "gid": {
          "type": "integer",
          "minimum": 0
        },
        "executable": {
          "const": true
        },
        "permissions": {
          "$ref": "#/$defs/sandboxFacts"
        },
        "elf": {
          "$ref": "#/$defs/elfMetadata"
        },
        "kind": {
          "enum": [
            "elf",
            "script"
          ]
        }
      }
    },
    "inventoryRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "artifactPath",
        "executablePath",
        "clientModule",
        "layer",
        "identity",
        "args",
        "headlessArgs",
        "headedArgs",
        "artifact",
        "executable",
        "sameRealPath"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "artifactPath": {
          "type": "string",
          "pattern": "^/"
        },
        "executablePath": {
          "type": "string",
          "pattern": "^/"
        },
        "clientModule": {
          "type": "string"
        },
        "layer": {
          "enum": [
            "engine",
            "launcher",
            "product"
          ]
        },
        "identity": {
          "enum": [
            "native",
            "persona"
          ]
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "headlessArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "headedArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifact": {
          "$ref": "#/$defs/fileIdentity"
        },
        "executable": {
          "$ref": "#/$defs/fileIdentity"
        },
        "sameRealPath": {
          "type": "boolean"
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "nodeFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runnerFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestSha256",
        "probes",
        "runner",
        "node"
      ],
      "properties": {
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "probes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/probe"
          }
        },
        "runner": {
          "$ref": "#/$defs/runnerFacts"
        },
        "node": {
          "$ref": "#/$defs/nodeFacts"
        }
      }
    },
    "seed": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "targetId",
        "mode",
        "iteration",
        "profileId",
        "args",
        "contextOptions",
        "suites"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "targetId": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "headless",
            "headed"
          ]
        },
        "iteration": {
          "type": "integer",
          "minimum": 1
        },
        "profileId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "seed": {
          "$ref": "#/$defs/seed"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contextOptions": {
          "type": "object",
          "additionalProperties": true
        },
        "suites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "probeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "suiteOptions": {
          "type": "object",
          "additionalProperties": true
        },
        "probeConfig": {},
        "scenarioIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "path",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "packageSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "patchManifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "entrySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown",
            "error",
            "unsupported",
            "skipped",
            "not-applicable"
          ]
        }
      }
    },
    "observationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observations",
        "checks",
        "limitations"
      ],
      "properties": {
        "observations": {},
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "status",
        "result"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "observed",
            "error",
            "unsupported",
            "skipped"
          ]
        },
        "result": {
          "$ref": "#/$defs/observationResult"
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "clean",
            "incomplete",
            "not-run"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "browserClosed": {
          "type": "boolean"
        },
        "contextsClosed": {
          "type": "boolean"
        },
        "processExited": {
          "type": "boolean"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration",
        "version",
        "client",
        "environment",
        "observations",
        "cleanup",
        "limitations"
      ],
      "properties": {
        "configuration": {
          "$ref": "#/$defs/configuration"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "client": {
          "$ref": "#/$defs/client"
        },
        "environment": {
          "$ref": "#/$defs/resolvedEnvironment"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "cleanup": {
          "$ref": "#/$defs/cleanup"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "auditError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "phase",
        "message"
      ],
      "properties": {
        "kind": {
          "enum": [
            "timeout",
            "protocol",
            "execution",
            "cleanup",
            "inventory",
            "configuration",
            "internal"
          ]
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "configurationId": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "targetClosed": {
          "type": "boolean"
        },
        "timeoutCategory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "ownedProcess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "startTicks"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "startTicks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "signalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "startTicks",
        "signal",
        "delivered"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "startTicks": {
          "type": "integer",
          "minimum": 0
        },
        "signal": {
          "type": "integer"
        },
        "delivered": {
          "type": "boolean"
        }
      }
    },
    "processCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootPid",
        "rootStartTicks",
        "discovered",
        "signalled",
        "residual",
        "clean"
      ],
      "properties": {
        "rootPid": {
          "type": "integer",
          "minimum": 1
        },
        "rootStartTicks": {
          "type": "integer",
          "minimum": 0
        },
        "discovered": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ownedProcess"
          }
        },
        "signalled": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signalRecord"
          }
        },
        "residual": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ownedProcess"
          }
        },
        "clean": {
          "type": "boolean"
        }
      }
    },
    "postprocessingRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originalReportPath",
        "originalReportSha256",
        "fragmentSha256",
        "planSha256",
        "toolVersion",
        "generatedAt",
        "reason"
      ],
      "properties": {
        "originalReportPath": {
          "type": "string",
          "pattern": "^/"
        },
        "originalReportSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fragmentSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "planSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "toolVersion": {
          "type": "string",
          "minLength": 1
        },
        "generatedAt": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
