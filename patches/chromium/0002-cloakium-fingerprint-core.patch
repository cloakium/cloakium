+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_CLOAKIUM_FINGERPRINT_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_CLOAKIUM_FINGERPRINT_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+
+#include "base/containers/span.h"
+#include "base/memory/scoped_refptr.h"
+#include "third_party/blink/renderer/core/core_export.h"
+
+namespace blink {
+
+class ExecutionContext;
+class SecurityOrigin;
+class StaticBitmapImage;
+
+namespace cloakium {
+
+// True when --fingerprint is present on the renderer command line.
+CORE_EXPORT bool IsFingerprintEnabled();
+
+// Reads --fingerprint-* switches. std::nullopt when the switch is absent or
+// its value is malformed.
+CORE_EXPORT std::optional<int> GetIntSwitch(const char* name);
+CORE_EXPORT std::optional<std::string> GetSwitchValue(const char* name);
+
+// Stable, origin-scoped seed. Same seed string + same origin => same value.
+// Origin scoping keeps noise consistent within an origin without making it a
+// cross-site identifier.
+CORE_EXPORT uint64_t SeedForOrigin(const SecurityOrigin* origin);
+CORE_EXPORT uint64_t SeedForExecutionContext(const ExecutionContext*);
+
+// Deterministic +-1 noise on the RGB bytes of an RGBA/BGRA 8-bit buffer. The
+// buffer must be a private copy: callers never mutate the backing canvas.
+CORE_EXPORT void PerturbRgbaPixels(base::span<uint8_t> pixels,
+                                  int width,
+                                  int height,
+                                  size_t bytes_per_pixel,
+                                  uint64_t seed);
+
+// Returns a perturbed copy of |image|. The original image is left untouched.
+CORE_EXPORT scoped_refptr<StaticBitmapImage> PerturbStaticBitmapImage(
+    scoped_refptr<StaticBitmapImage> image,
+    uint64_t seed);
+
+// Deterministic, inaudible sample noise applied once to a rendered audio
+// buffer. Added at render handoff, not on every read.
+CORE_EXPORT void PerturbAudioSamples(base::span<float> samples,
+                                     uint64_t seed,
+                                     unsigned channel);
+
+// Static, coherent WebGL unmasked string overrides. std::nullopt unless
+// --fingerprint-webgl-profile names a known profile.
+CORE_EXPORT std::optional<std::string> GetWebglVendorOverride();
+CORE_EXPORT std::optional<std::string> GetWebglRendererOverride();
+
+}  // namespace cloakium
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_CLOAKIUM_FINGERPRINT_H_
