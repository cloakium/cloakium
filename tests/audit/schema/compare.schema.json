{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cloakium.audit.compare/1",
  "title": "Cloakium audit comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "generatedAt", "baseline", "candidate", "confounders",
    "causalAttribution", "features", "differences", "gaps", "summary",
    "complete", "completeness"
  ],
  "properties": {
    "schema": { "const": "cloakium.audit.compare/1" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "baseline": { "$ref": "#/$defs/reportRef" },
    "candidate": { "$ref": "#/$defs/reportRef" },
    "policy": { "$ref": "#/$defs/policyRef" },
    "plan": { "$ref": "#/$defs/planRef" },
    "confounders": { "type": "array", "items": { "$ref": "#/$defs/confounder" } },
    "causalAttribution": { "type": "string", "minLength": 1 },
    "features": { "type": "array", "items": { "$ref": "#/$defs/featureCoverage" } },
    "differences": { "type": "array", "items": { "$ref": "#/$defs/difference" } },
    "gaps": { "type": "array", "items": { "$ref": "#/$defs/difference" } },
    "summary": { "$ref": "#/$defs/summary" },
    "complete": { "type": "boolean" },
    "completeness": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "reportRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "runId", "planHash", "complete", "targetId"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "runId": { "type": "string", "minLength": 1 },
        "planHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "complete": { "type": "boolean" },
        "targetId": { "type": "string", "minLength": 1 }
      }
    },
    "policyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "planRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "complete"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "complete": { "type": "boolean" }
      }
    },
    "confounder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "baseline", "candidate"],
      "properties": {
        "axis": { "type": "string", "minLength": 1 },
        "baseline": { "type": "string" },
        "candidate": { "type": "string" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executed", "accepted", "failed", "unknown", "unsupported", "runs", "statuses"],
      "properties": {
        "executed": { "type": "boolean" },
        "accepted": { "type": "boolean" },
        "failed": { "type": "boolean" },
        "unknown": { "type": "boolean" },
        "unsupported": { "type": "boolean" },
        "runs": { "type": "integer", "minimum": 0 },
        "statuses": { "type": "array", "items": { "type": "string" } }
      }
    },
    "modePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headless", "headed"],
      "properties": {
        "headless": { "$ref": "#/$defs/coverage" },
        "headed": { "$ref": "#/$defs/coverage" }
      }
    },
    "featureCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "families", "baseline", "candidate"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "families": { "type": "array", "items": { "type": "string" } },
        "baseline": { "$ref": "#/$defs/modePair" },
        "candidate": { "$ref": "#/$defs/modePair" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "runId", "configurationId", "targetId", "mode", "iteration"],
      "properties": {
        "role": { "enum": ["baseline", "candidate"] },
        "runId": { "type": "string", "minLength": 1 },
        "configurationId": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["headless", "headed"] },
        "iteration": { "type": "integer", "minimum": 1 }
      }
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["featureId", "family", "classification", "gap", "unknown", "detail"],
      "properties": {
        "featureId": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "classification": {
          "enum": [
            "capability-difference", "shared-failure", "stable-field-difference",
            "ordinary-variation", "headless-regression", "headless-improvement",
            "iteration-instability", "execution-error", "coverage-gap",
            "unsupported", "unknown", "intentional-difference"
          ]
        },
        "originalClassification": { "type": "string", "minLength": 1 },
        "subtype": { "type": "string", "minLength": 1 },
        "check": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["headless", "headed"] },
        "baselineStatus": { "type": "string", "minLength": 1 },
        "candidateStatus": { "type": "string", "minLength": 1 },
        "gap": { "type": "boolean" },
        "unknown": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 },
        "baseline": {},
        "candidate": {},
        "provenance": { "type": "array", "items": { "$ref": "#/$defs/provenance" } },
        "confounders": { "type": "array", "items": { "type": "string" } },
        "causalAttribution": { "type": "string", "minLength": 1 },
        "policyId": { "type": "string", "minLength": 1 },
        "justification": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "features", "differences", "gaps", "capabilityDifferences", "sharedFailures",
        "stableFieldDifferences", "ordinaryVariation", "headlessRegressions",
        "headlessImprovements", "iterationInstability", "executionErrors",
        "coverageGaps", "unsupported", "unknown", "intentional"
      ],
      "properties": {
        "features": { "type": "integer", "minimum": 0 },
        "differences": { "type": "integer", "minimum": 0 },
        "gaps": { "type": "integer", "minimum": 0 },
        "capabilityDifferences": { "type": "integer", "minimum": 0 },
        "sharedFailures": { "type": "integer", "minimum": 0 },
        "stableFieldDifferences": { "type": "integer", "minimum": 0 },
        "ordinaryVariation": { "type": "integer", "minimum": 0 },
        "headlessRegressions": { "type": "integer", "minimum": 0 },
        "headlessImprovements": { "type": "integer", "minimum": 0 },
        "iterationInstability": { "type": "integer", "minimum": 0 },
        "executionErrors": { "type": "integer", "minimum": 0 },
        "coverageGaps": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "intentional": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
