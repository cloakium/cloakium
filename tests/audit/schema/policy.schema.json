{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cloakium.audit.policy/1",
  "title": "Cloakium audit comparison policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "allowlist", "stableFields"],
  "properties": {
    "schema": { "const": "cloakium.audit.policy/1" },
    "allowlist": {
      "type": "array",
      "items": { "$ref": "#/$defs/allowlistEntry" }
    },
    "stableFields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._\\-\\[\\]:$]+$"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "allowlistEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "justification", "featureIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "justification": { "type": "string", "minLength": 10 },
        "featureIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "modes": {
          "type": "array",
          "items": { "enum": ["headless", "headed"] },
          "uniqueItems": true
        }
      }
    }
  }
}
